#!/bin/bash
# Print what can be observed of this agent node as one JSON document:
# {"online", "name", "self", "node", "subscribers", "state", "profiles",
# "follows", "persona", "activity", "last_active", "events", "context", "requests",
# "messages", "urgent", "attention", "looked_at"}. "activity" is what the agent identity signed and
# the Requests it answered, newest first; an answered Request is an entry with a
# "request" field and the id "request:<id>". "last_active" is the newest
# created_at of the entries, or null; "events" is the rest of the feed, without
# the agent's. Every event, in either and in "context", says what it refers to
# ("refers_to", an id or null), whether the relay lacks that event
# ("refers_missing"), and which events refer to it ("referenced_by", ids, oldest
# first). "context" holds the events a thread needs that the feed's limit left
# out: those that shown events refer to, and those that refer to them.
# "persona" is the agent identity's newest profile as {name, character, picture,
# created_at} (the profile's name, about and picture, each "" when absent), or
# null when the public key is not known or the agent has published no profile
# with a name: the Install has no Persona yet.
# "requests" is every Request in the queue, newest first (a file that is not a
# valid Request is skipped). "messages" is the agent identity's private messages
# as {readable, reason, supervisor, conversations}: the conversations newest
# first, each {id, participants (without the agent), subject, last_at, messages},
# its messages oldest first, each {id, from, sent, created_at, body, file,
# reply_to}. They are read whether or not the relay runs. While they cannot be
# read, "readable" is false and "reason" says why: "unsupported" (this `toon`
# has no `message list`), "agent_key_not_kept" (the agent node does not keep the
# agent identity's secret yet) or "unavailable". "supervisor" is whether it is
# running, and so opening what arrives. "attention" is "none", "news" (an
# Activity entry, an event tagging the agent, or a private message to it, is
# newer than the last time the Observer looked) or "urgent" (the node is not running, or nothing is left of today's
# spending limit); "looked_at" is when the Observer last looked, or null.
# "install" is what the launcher made on this machine, or null when there is
# none and the node is `toon` on this machine's PATH: {present, network,
# connector_zone ("running", "stopped", "not created"), agent_zone ("in a
# session", "idle", "not created"), supervisor (true, false or null), timer
# {on, interval, active, next, last_unattended}, model, ceiling, apps [{name,
# running, price, image, toon_app}], waiting_apps [{name, image, since, asks,
# secrets}], earnings {received, landed, fees, packets} or null, agent_key
# {public_key, scope, per_command, per_day, toon_apps} or null}. An Install's
# node runs inside the connector's zone, a microsandbox virtual machine, so
# every `toon` command, the relay query and the NIP-11 fetch run in that zone
# (`msb exec`), as the launcher runs them; the zone is never started from
# here, so while it is stopped the node reads as absent. The agent's public
# key, its Renderers and the Requests are read from the two directories the
# launcher mounts into the agent's zone, under the state folder's `agent/`.
# Read-only: nothing here opens the keystore, spends, changes state or
# publishes. Only free `toon` commands are run: status, relay config, peer list,
# channel list, route list, limit show, packet count, packet list, packet history, relay subscriptions, logs, agent-key
# list (never a private half) and message list, which prints what the
# supervisor already opened. Wallet balances are never read (they need the
# passphrase, ADR 0001), and no command run in the zone is given the passphrase.
#
# "packets" is what `toon packet count` prints, since the connector last
# started: {"fulfilled", "rejected", "rejects": [{"code", "count"}] sorted by
# code, "fees_earned"} with the fees as a string in base units. Packet traffic
# adds no Activity entry and never changes "urgent" or "attention".
#
# "state" is the node as `toon` reports it, or null when there is no agent node.
# "rejected_packets" is what `toon packet list` prints, newest first, as the
# command printed them: [{"time", "destination", "code", "message"}], [] when
# nothing was rejected. An entry lacking one of them, or not a reject, is left
# out. Rejected packets add no Activity entry and never change "urgent" or
# "attention".
#
# "packet_history" is what `toon packet history --json` prints, the connector's
# recent packets newest first, kept in its memory and forgotten when it restarts:
# {"packets": [{"time", "direction", "destination", "from", "to", "amount",
# "fee", "outcome", "code", "message"}], "dropped"} with only the fields a packet
# has, all strings. A row that is not an object, or lacks a string time or
# outcome, is left out; a field that is not a string is absent; "dropped" is 0
# when missing or not a number. [] packets is a connector with its history off
# or with nothing handled (toon prints the same). No packet adds an Activity
# entry or changes "urgent" or "attention".
#
# Each group in it (status, relay, peers, channels, routes, limits, packets,
# rejected_packets, packet_history,
# subscriptions, logs) is null when its command failed, returned an error
# document or answered in a shape not understood, so the rest still shows.
#
# The relay's read port changes on every `toon up`, so it is looked up from
# `toon status` each time. Environment, so that tests can run against a stub:
#   SPACETURTLE_TOON        the toon command (default: toon)
#   SPACETURTLE_CONFIG_DIR  where the agent writes its public key, in the file
#                           `agent-pubkey`, and its Renderer descriptions, one
#                           file per kind in `renderers/`
#                           (default: ~/.config/spaceturtle)
#   SPACETURTLE_STATE_DIR   where `request` keeps its queue, in `requests`,
#                           `mark-seen` records that the Observer looked, and
#                           the last snapshot of the node is kept, in the file
#                           `node-snapshot.json`
#                           (default: ~/.local/state/spaceturtle)
#   SPACETURTLE_NOW         the time now, in seconds (default: the clock)
#   SPACETURTLE_MSB_HOME    microsandbox's home, the launcher's (default: ~/.local/share/spaceturtle/msb,
#                           or ~/.spaceturtle-msb when that is more than 54 characters long)
#   SPACETURTLE_MSB         the msb program (default: bin/msb in that home)
#   SPACETURTLE_ZONE        the connector's zone's name (default: st-connector)
#   SPACETURTLE_AGENT_ZONE  the agent's zone's name (default: st-agent)
#   SPACETURTLE_SYSTEMCTL   the systemctl program, which reports the timer (default: systemctl)
#   HOME                    ~/.local/bin is put on PATH
#
# An Install is recognised by the launcher's settings file, `launcher.conf` in
# the config folder, or by the agent's directories, `agent/` in the state
# folder. With neither, the node is `toon` on PATH, the public key and the
# Renderers are read from the config folder and the Requests from `requests/`
# in the state folder.
#
# Node changes: `toon` does not report that a channel opened or a price moved, so
# each run compares the node's state with the snapshot the run before left, and
# every difference becomes an entry in "activity" (marked "node_change", with the
# time it was noticed, never the time it happened, and a "target" in the Node
# section). When the snapshot is older than four refresh intervals (the second
# argument, in seconds) the differences are one "since you last looked" entry.
# The first run, with no snapshot, has none. Entries are kept across runs, at
# most 50. "urgent" is true when nothing is left of today's spending limit.
set -uo pipefail
PATH="$HOME/.local/bin:$PATH"

toon_cmd=${SPACETURTLE_TOON:-toon}
config_dir=${SPACETURTLE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/spaceturtle}
state_dir=${SPACETURTLE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/spaceturtle}
snapshot=$state_dir/node-snapshot.json
systemctl_=${SPACETURTLE_SYSTEMCTL:-systemctl}

# The Install, if the launcher made one here: its settings, the agent's two
# directories, and its zones under microsandbox, kept in a home of the launcher's.
launcher_conf=$config_dir/launcher.conf
agent_dir=$state_dir/agent
msb_home=${SPACETURTLE_MSB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/spaceturtle/msb}
(( ${#msb_home} <= 54 )) || [[ -n ${SPACETURTLE_MSB_HOME:-} ]] || msb_home=$HOME/.spaceturtle-msb
msb=${SPACETURTLE_MSB:-$msb_home/bin/msb}
zone=${SPACETURTLE_ZONE:-st-connector}
agent_zone=${SPACETURTLE_AGENT_ZONE:-st-agent}
install=false
[[ -f $launcher_conf || -d $agent_dir ]] && install=true

# Where the agent writes its public key and its Renderers, and where the
# Requests wait: in an Install, the directories the agent's zone mounts.
if $install; then agent_config=$agent_dir/config; queue=$agent_dir/state/requests
else agent_config=$config_dir; queue=$state_dir/requests; fi

# What microsandbox lists, and the state of a zone in it.
zones='[]'
if $install && [[ -x $msb ]]; then
  zones=$(MSB_HOME=$msb_home "$msb" ls --format json 2>/dev/null)
  jq -e 'type == "array"' <<<"$zones" >/dev/null 2>&1 || zones='[]'
fi
zone_state() {
  jq -r --arg z "$1" '[.[] | objects | select(.name == $z)] | first
    | if . == null then "not created" elif ((.status | strings | ascii_downcase) == "running") then "running" else "stopped" end' <<<"$zones" 2>/dev/null || echo "not created"
}
connector_state=$(zone_state "$zone")
agent_state=$(zone_state "$agent_zone")

# Quotes a value for the shell that runs the node's commands.
sh_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
with_timeout() { if command -v timeout >/dev/null; then timeout "$@"; else shift; "$@"; fi; }
export SPACETURTLE_TOON_CMD=$toon_cmd
# Runs one shell line where the node is: in the connector's zone, as the
# launcher does, or on this machine. Nothing in the zone is given the passphrase.
# A zone that is not running is left alone, and the line fails.
node_sh() {
  if $install; then
    [[ $connector_state == running && -x $msb ]] || return 1
    MSB_HOME=$msb_home with_timeout 15 "$msb" exec --quiet --no-stdin "$zone" -- sh -c "$1"
  else
    with_timeout 10 bash -c 'toon() { command "$SPACETURTLE_TOON_CMD" "$@"; }; '"$1"
  fi
}
# Whether the node can be asked anything at all.
node_reachable() {
  if $install; then [[ $connector_state == running && -x $msb ]]
  else command -v "$toon_cmd" >/dev/null; fi
}

limit=${1:-40}
[[ $limit =~ ^[0-9]+$ ]] || limit=40
interval=${2:-30}
[[ $interval =~ ^[0-9]+$ ]] || interval=30
now=${SPACETURTLE_NOW:-$(date +%s)}
[[ $now =~ ^[0-9]+$ ]] || now=$(date +%s)

# The entries the last snapshot kept, until this run finds a state to compare.
changes=$(jq -c '.changes // [] | if type == "array" then . else [] end' "$snapshot" 2>/dev/null)
[[ -n $changes ]] || changes='[]'
urgent=false

# The Requests in the queue, newest first. They are local files, so they are
# listed whether or not the relay runs. The id is the file's name.
read_requests() {
  local file
  [[ -d $queue ]] || { echo '[]'; return; }
  for file in "$queue"/*.json; do
    [[ -f $file ]] || continue
    jq -ce --arg id "$(basename "$file" .json)" '
      select(type == "object"
        and (.created_at | type == "number")
        and (.kind | type == "string")
        and (.text | type == "string")
        and (.state == "waiting" or .state == "done" or .state == "declined"))
      | {id: $id, created_at, kind, text, state,
         subject: (.subject | if type == "object" then . else {} end),
         answered_at: (.answered_at | numbers // null),
         result: (.result | if type == "object" then . else null end),
         reason: (.reason | strings // null)}' "$file" 2>/dev/null || true
  done | jq -sc 'sort_by(-.created_at)' 2>/dev/null || echo '[]'
}

# What the agent answered, as Activity entries.
request_activity() {
  jq -c --arg self "$1" '
    map(select(.state != "waiting")
      | {id: ("request:" + .id), pubkey: $self, kind: null, tags: [], content: .text,
         created_at: (.answered_at // .created_at),
         refers_to: (.result.event | strings // null), request: .})' <<<"$2"
}

requests=$(read_requests)

# The agent identity's public key, from a file the agent writes during setup.
self=
if [[ -r $agent_config/agent-pubkey ]]; then
  read -r self < "$agent_config/agent-pubkey" || true
  [[ $self =~ ^[0-9a-f]{64}$ ]] || self=
fi

# When the Observer last looked, from the file `mark-seen` writes.
looked_at=
if [[ -r $state_dir/last-looked ]]; then
  read -r looked_at < "$state_dir/last-looked" || true
  [[ $looked_at =~ ^[0-9]+$ ]] || looked_at=
fi

# Without the relay, the Activity is what the agent answered, which is local.
offline() {
  command -v jq >/dev/null || {
    printf '{"online":false,"name":"","self":"","node":{"ilp_address":"","connector":""},"subscribers":null,"profiles":[],"follows":[],"persona":null,"state":null,"urgent":false,"activity":[],"last_active":null,"events":[],"context":[],"requests":[],"messages":{"readable":false,"reason":"unavailable","supervisor":false,"conversations":[]},"attention":"urgent","looked_at":null}\n'
    exit 0
  }
  jq -cn --argjson requests "${requests:-[]}" --argjson messages "${messages:-$no_messages}" \
    --argjson state "${state:-null}" --argjson looked "${looked_at:-null}" \
    --argjson answered "$(request_activity "$self" "${requests:-[]}")" \
    --argjson changes "$changes" --argjson urgent "$urgent" --arg self "$self" \
    --argjson install "${install_doc:-null}" \
    '($answered | sort_by(-.created_at)) as $activity
    | {online:false,name:"",self:$self,node:{ilp_address:"",connector:""},subscribers:null,state:$state,urgent:$urgent,profiles:[],follows:[],persona:null,
       activity:(($activity + $changes) | sort_by(-.created_at)),last_active:($activity[0].created_at? // null),events:[],context:[],requests:$requests,messages:$messages,
       install:$install,attention:"urgent",looked_at:$looked}'
  exit 0
}

# The JSON a free toon command printed, or null if it failed, printed nothing
# or printed an error document. The arguments are literals, or quoted by the caller.
toon_json() {
  local out
  out=$(node_sh "toon $*" 2>/dev/null) || { echo null; return; }
  # Several JSON values, one per line, are read as one array of them.
  out=$(jq -cs 'if length == 0 then null elif length == 1 then .[0] else . end | if type == "object" and has("error") then null else . end' <<<"$out" 2>/dev/null)
  echo "${out:-null}"
}

# The agent identity's private messages, grouped into conversations. `toon
# message list` prints what the supervisor opened and kept, so it needs no
# passphrase. A `toon` without the command answers with exit code 2.
no_messages='{"readable":false,"reason":"unavailable","supervisor":false,"conversations":[]}'
read_messages() {
  local out code
  out=$(node_sh "toon message list --limit 200 --json" 2>/dev/null)
  code=$?
  out=$(jq -cs --arg self "$self" --argjson code "$code" '
    def locked($reason): {readable: false, reason: $reason, supervisor: false, conversations: []};
    def tagged($n): [(.tags | arrays // [])[] | arrays | select(.[0] == $n and length > 1) | .[1] | strings];
    # The code of an error document, or null.
    def failed: if type == "object" and (.error | type) == "object" then .error.code else null end;
    (if length == 1 then .[0] else null end)
    | if $code == 2 or failed == "usage" then locked("unsupported")
      elif failed == "agent_key_not_kept" then locked("agent_key_not_kept")
      elif type != "object" or (.messages | type) != "array" then locked("unavailable")
      else
        [.messages[] | select(type == "object" and (.id | type) == "string"
          and (.from | type) == "string" and (.created_at | type) == "number")] as $all
        # Who the agent is: the public key file, else the sender of what it sent.
        | (if $self != "" then $self else ([$all[] | select(.sent == true) | .from] | first // "") end) as $me
        | {readable: true, reason: "", supervisor: (.supervisor == "running"),
           conversations: ($all | group_by(.conversation | strings // "") | map(
             sort_by(.created_at, .id) as $c
             | ([$c[] | (.participants | arrays // [])[] | strings] | unique) as $keys
             | {id: ($c[0].conversation | strings // ""),
                # A conversation of the agent alone is a note to itself.
                participants: (($keys - [$me]) | if length == 0 then $keys else . end),
                subject: ([$c[] | tagged("subject")[]] | last // ""),
                last_at: $c[-1].created_at,
                messages: [$c[] | {id, from, sent: (.sent == true), created_at,
                  body: (.content | strings // ""), file: (.kind == 15),
                  reply_to: (tagged("e") | first // null)}]})
             | sort_by(-.last_at))}
      end' <<<"$out" 2>/dev/null)
  echo "${out:-$no_messages}"
}

relay_query() {
  node_sh "toon event query $(sh_quote "ws://$read_address") --filter $(sh_quote "$1") --json" 2>/dev/null | jq -c '.events // []' 2>/dev/null || echo '[]'
}

state=null

# Renderers: resolve an event into its parts, {label, title, summary, body,
# links, media, ref}. A built-in Renderer handles a known kind and the fallback every
# other; the panel lays out parts and never interprets a kind. The part names
# are the ones an agent-written description (ADR 0002) uses.
#   label    what the event did, shown by its author ("" for a plain note)
#   title    one headline line, or ""
#   summary  a short line under the title, or ""
#   body     the text
#   links    http(s) addresses only
#   media    what to show or play under the text, at most four, each {url,
#            type, moving}: type is "image", "video" or "audio", and moving
#            says an image is animated. They are what an `imeta` tag says is
#            one of the three, and the addresses in the text that end as one,
#            http(s) only. The same for every kind, built-in or described. The
#            one exception is a stored file (kind 5094) that is a picture of
#            at most 262144 base64 characters: its own bytes, as a `data:`
#            address that relay-events builds and an event cannot supply.
#   ref      the id of the event this one refers to, or ""
# Renderers the agent wrote (ADR 0002): one JSON file per kind in
# $config_dir/renderers/, read afresh each run so a new one shows on the next
# refresh. Each is data, never evaluated: a description names where a part comes
# from, {"tag": NAME} or {"content": true}, and nothing else. One that is
# malformed is ignored and its events fall back; one for a kind with a built-in
# Renderer is never reached, since `parts` tries the built-in ones first. The
# result maps a kind to its normalised description; the first by file name (in
# byte order) wins a kind.
read_custom_renderers() {
  local file LC_COLLATE=C
  [[ -d $agent_config/renderers ]] || { echo '{}'; return; }
  for file in "$agent_config"/renderers/*.json; do
    [[ -f $file ]] || continue
    jq -sce '
      def source: type == "object" and (
        (keys == ["tag"] and (.tag | type == "string" and length > 0)) or (keys == ["content"] and .content == true));
      def norm: if . == null then null elif has("tag") then {tag} else {content: true} end;
      select(length == 1) | .[0]
      | select(type == "object"
        and (.kind | type == "number" and . >= 0 and . == floor)
        and (.label == null or (.label | type == "string"))
        and ([.title, .summary, .body, .refers_to] | all(. == null or source))
        and (.links == null or (.links | type == "array" and all(type == "object" and keys == ["tag"] and (.tag | type == "string" and length > 0)))))
      | {key: (.kind | tostring), value: {
          label: (.label // ("kind " + (.kind | tostring))),
          title: (.title | norm), summary: (.summary | norm), body: (.body | norm), refers_to: (.refers_to | norm),
          links: [(.links // [])[] | {tag}]}}' "$file" 2>/dev/null || true
  done | jq -sc 'reduce .[] as $e ({}; if has($e.key) then . else . + {($e.key): $e.value} end)' 2>/dev/null || echo '{}'
}
custom_renderers=$(read_custom_renderers)

renderers=$(cat <<'JQ'
def tags: (.tags | arrays // [])[] | arrays;
def tag($n): [tags | select(.[0] == $n and length > 1) | .[1] | strings] | first // "";
def text: (.content | strings) // "" | gsub("^\\s+|\\s+$"; "");
def links: [tags | select((.[0] == "r" or .[0] == "url" or .[0] == "web") and length > 1) | .[1] | strings | select(test("^https?://"))] | unique;
def media_kind($mime; $url):
  if ($mime | startswith("image/")) then "image" elif ($mime | startswith("video/")) then "video"
  elif ($mime | startswith("audio/")) then "audio" elif $mime != "" then null
  elif ($url | test("\\.(png|jpe?g|gif|webp|avif|bmp|svg)(\\?\\S*)?$"; "i")) then "image"
  elif ($url | test("\\.(mp4|m4v|webm|mov|mkv|ogv)(\\?\\S*)?$"; "i")) then "video"
  elif ($url | test("\\.(mp3|ogg|oga|opus|wav|flac|m4a|aac)(\\?\\S*)?$"; "i")) then "audio"
  else null end;
def medium($mime; $url): media_kind($mime; $url) as $k
  | select($k != null and ($url | test("^https?://\\S+$")))
  | {url: $url, type: $k, moving: ($k == "image" and ($mime == "image/gif" or ($url | test("\\.gif(\\?\\S*)?$"; "i"))))};
def imeta_media: [tags | select(.[0] == "imeta") | [.[1:][] | strings] as $f
  | ([$f[] | select(startswith("url ")) | ltrimstr("url ")] | first // "") as $u
  | ([$f[] | select(startswith("m ")) | ltrimstr("m ")] | first // "") as $m
  | medium($m; $u)];
def media: (imeta_media + [text | scan("https?://\\S+") | medium(""; .)])
  | reduce .[] as $m ([]; if any(.[]; .url == $m.url) then . else . + [$m] end) | .[0:4];
def base: {label: "", title: "", summary: "", body: text, links: links, media: media, ref: tag("e")};
def meta: (.content | strings | try fromjson catch null) | if type == "object" then . else {} end;
def fallback:
  base + {label: ("kind " + (.kind | tostring)),
    title: tag("alt"),
    summary: ([tags | map(strings) | join(" ")] | join(", "))};
def from($s): if $s == null then "" elif $s.tag != null then tag($s.tag) else text end;
def described($d): {label: $d.label, title: from($d.title), summary: from($d.summary), body: from($d.body),
  links: ([$d.links[] as $l | tags | select(.[0] == $l.tag and length > 1) | .[1] | strings | select(test("^https?://"))] | unique),
  media: media, ref: from($d.refers_to)};
# A description that leaves the event nothing to show, its tags lacking every
# part it names, gives way to the fallback, so no event is invisible.
def described_or_fallback($d): . as $e | described($d) | if .title == "" and .summary == "" and .body == "" then $e | fallback else . end;
def parts:
  if .kind == 0 then (meta) as $m | base + {label: "updated profile", title: ($m.name | strings // ""), summary: ($m.about | strings // ""), body: "", ref: ""}
  elif .kind == 1 then base + {label: (if tag("e") != "" then "replied" else "" end)}
  elif .kind == 3 then base + {label: "updated follows", body: ([tags | select(.[0] == "p")] | length | tostring + " followed"), ref: ""}
  elif .kind == 5 then base + {label: "deleted", summary: ([tags | select(.[0] == "e" or .[0] == "a") | .[1] | strings] | length | tostring + " deleted")}
  elif .kind == 6 or .kind == 16 then base + {label: "reposted", body: ""}
  elif .kind == 7 then base + {label: "reacted", body: (text | if . == "+" or . == "" then "󰋑" elif . == "-" then "󰋕" else . end)}
  elif .kind == 1111 then base + {label: "commented"}
  elif .kind == 30023 then base + {label: "published", title: tag("title"), summary: tag("summary")}
  elif .kind == 5094 then tag("output") as $type
    | ([tags | select(.[0] == "i" and .[2] == "blob") | .[1] | strings] | first // "") as $blob
    | base + {label: "stored a file", ref: "",
        summary: ([$type, (if $blob == "" then "" else ($blob | (length * 3 / 4 | floor) - ([scan("=")] | length) | tostring) + " bytes" end)] | map(select(. != "")) | join(", ")),
        media: (if ($type | test("^image/(png|jpeg|gif|webp)$")) and ($blob | length > 0 and length <= 262144 and test("^[A-Za-z0-9+/]+=*$"))
          then [{url: ("data:" + $type + ";base64," + $blob), type: "image", moving: ($type == "image/gif")}] else media end)}
  elif .kind == 30817 then base + {label: "drafted", title: (tag("title") | if . == "" then tag("d") else . end), summary: tag("summary")}
  elif $custom[0][.kind | tostring] != null then described_or_fallback($custom[0][.kind | tostring])
  else fallback end;
JQ
)

# --- the Install, as the launcher left it: settings, zones, timer ---
conf_get() { # name, default
  local v
  v=$(sed -n "s/^$1=//p" "$launcher_conf" 2>/dev/null | tail -n 1)
  echo "${v:-$2}"
}
install_doc=null
if $install; then
  timer_active=null
  timer_next=null
  if command -v "$systemctl_" >/dev/null; then
    if "$systemctl_" --user is-active --quiet spaceturtle.timer 2>/dev/null; then timer_active=true; else timer_active=false; fi
    timer_next=$("$systemctl_" --user list-timers spaceturtle.timer --all --output json 2>/dev/null \
      | jq -c '[.[] | select(.unit == "spaceturtle.timer") | .next | numbers | select(. > 0) | . / 1000000 | floor] | first // null' 2>/dev/null)
    [[ -n $timer_next ]] || timer_next=null
  fi
  last_unattended=null
  if [[ -s $state_dir/last-unattended ]]; then
    last_unattended=$(date -d "$(<"$state_dir/last-unattended")" +%s 2>/dev/null) || last_unattended=null
  fi
  install_doc=$(jq -cn --arg connector "$connector_state" --arg agent "$agent_state" \
    --arg timer "$(conf_get timer on)" --arg interval "$(conf_get interval 6h)" \
    --argjson active "$timer_active" --argjson next "$timer_next" --argjson last "$last_unattended" \
    --arg model "$(conf_get model "")" --arg ceiling "$(conf_get ceiling 1)" \
    --arg network "$(sed -n 's/.*--network \([a-z]*\).*/\1/p' <<<"$(conf_get init "")")" '
    {present: true, network: $network, connector_zone: $connector,
     agent_zone: (if $agent == "running" then "in a session" elif $agent == "stopped" then "idle" else $agent end),
     supervisor: null,
     timer: {on: ($timer == "on"), interval: $interval, active: $active, next: $next, last_unattended: $last},
     model: $model, ceiling: $ceiling, apps: [], waiting_apps: [], earnings: null, agent_key: null}' 2>/dev/null) || install_doc=null
fi

node_reachable && command -v jq >/dev/null || offline
messages=$(read_messages)
status=$(toon_json status --json)
relay_config=$(toon_json relay config --json)
# toon 0.2.0 reads a TOON app's connector's log by name; an older toon the node's.
log_app=$(jq -r '.agent_node.toon_apps[0].name // empty' <<<"$status" 2>/dev/null)
logs=null
[[ -z $log_app ]] || logs=$(toon_json logs --json --connector --lines 20 -- "$(sh_quote "$log_app")")
[[ $logs != null ]] || logs=$(toon_json logs --json)
channels=$(toon_json channel list --json)
packets=$(toon_json packet count --json)
# The agent key's public half, scope and limits; a private half, were one ever
# printed, is dropped before anything is read.
agent_keys=$(toon_json agent-key list --json | jq -c 'walk(if type == "object" then with_entries(select(.key | test("private|secret|seed"; "i") | not)) else . end)' 2>/dev/null)
[[ -n $agent_keys ]] || agent_keys=null
if $install && [[ $install_doc != null ]]; then
  network_in_zone=$(node_sh 'cat "$HOME/.toon/agent-node/state.json"' 2>/dev/null | jq -r '.network // empty' 2>/dev/null)
  install_doc=$(jq -c --argjson status "$status" --argjson channels "$channels" --argjson packets "$packets" \
    --argjson keys "$agent_keys" --arg network "${network_in_zone:-}" '
    def str: if . == null then "" elif type == "string" then . else tojson end;
    def num: if type == "number" then . else (tonumber? // 0) end;
    . + {network: (if $network != "" then $network elif .network != "" then .network else "devnet" end),
      supervisor: ($status | if type == "object" then (.agent_node.supervisor.running | if type == "boolean" then . else null end) else null end),
      apps: ($status | if type == "object" then [.agent_node.toon_apps[]? as $t | $t.apps[]? | objects
        | {name: (.name | str), running: (.running == true), price: (.price | str), image: (.image | str), toon_app: ($t.name | str)}] else [] end),
      waiting_apps: ($status | if type == "object" then [.. | objects | .pending_apps? | arrays | .[] | objects
        | select((.name // "") != "" and (.state // .status // "pending") == "pending" and (.refused // null) == null)
        | {name, image: (.image // .url // "" | str), since: (.requested_at // .asked_at // .since // .created_at // .at // null),
           secrets: [.secrets.variables[]?, .secrets.files[]? | strings],
           asks: ([(.price | select(. != null and . != 0) | "price \(.)"),
                   ([.variables[]? | strings] | select(length > 0) | "variables " + join(" ")),
                   (select(.allowances.allow_egress == true) | "the network"),
                   ([.secrets.variables[]?, .secrets.files[]? | strings] | select(length > 0) | "secrets " + join(" "))] | join("; "))}]
        | unique_by(.name) else [] end),
      earnings: (if ($channels | type) != "object" and ($packets | type) != "object" then null else
        {received: ($channels | if type == "object" then ([.channels[]? | select(.direction == "inbound") | .watermark | num] | add // 0) else null end),
         landed: ($channels | if type == "object" then ([.channels[]? | select(.direction == "inbound") | .landed | num] | add // 0) else null end),
         fees: ($packets | if type == "object" then (.fees_earned | str) else null end),
         packets: ($packets | if type == "object" then (.packets.fulfilled | num) else null end)} end),
      agent_key: ($keys | if type != "object" and type != "array" then null else
        ((if type == "array" then . else (.agent_keys // .keys // []) end) | map(objects) | first
         | if . == null then null else {public_key: (.public_key // .id | str), scope: [.scope[]? | strings],
             per_command: (.spending_limit.per_command | str), per_day: (.spending_limit.per_day | str),
             toon_apps: [.toon_apps[]? | strings]} end) end)}' <<<"$install_doc" 2>/dev/null) || install_doc=null
  [[ -n $install_doc ]] || install_doc=null
fi

# The node's state, from free commands only. Each group is mapped on its own, so
# a group whose command failed, or whose answer has a shape not understood, is
# null and the rest still shows. A failing `toon status` leaves its group null;
# a status with no agent node leaves the whole state null.
incoming=$(toon_json relay subscriptions --incoming --json)
if [[ $status == null ]] || jq -e '.agent_node | type == "object"' <<<"$status" >/dev/null 2>&1; then
  state=$(jq -cn --argjson status "$status" --argjson relay "$relay_config" \
    --argjson peers "$(toon_json peer list --json)" \
    --argjson channels "$channels" \
    --argjson routes "$(toon_json route list --json)" \
    --argjson limits "$(toon_json limit show --json)" \
    --argjson packets "$packets" \
    --argjson rejected "$(toon_json packet list --json)" \
    --argjson history "$(toon_json packet history --json)" \
    --argjson held "$(toon_json relay subscriptions --json)" \
    --argjson incoming "$incoming" \
    --argjson logs "$logs" '
    def str: if . == null then "" elif type == "string" then . else tojson end;
    def count: if type == "number" then . else (tonumber? // 0) end;
    def items(key): if . == null then null
      elif type == "array" then . else (.[key] // ([.. | arrays] | first) // []) end;
    def process: if . == null then {running: null, restarts: 0}
      elif type == "boolean" then {running: ., restarts: 0}
      else {running: ([.running, .up] | map(select(. != null)) | if length > 0 then .[0] == true else null end),
        restarts: (.restarts // .restart_count // 0 | count)} end;
    def group(f): if . == null then null else (try f catch null) end;
    {
      status: ($status | group(.agent_node as $n | {
        supervisor: ($n.supervisor | process),
        # toon 0.2.0 has a connector for each TOON app; the first is the one of the node.
        connector: (($n.connector // $n.toon_apps[0].connector) | process),
        apps: [$n.toon_apps[]?.apps[]? | {name: (.name | str), running: (.running == true),
          restarts: (.restarts // .restart_count // 0 | count), price: (.price | str), image: (.image | str)}]
      })),
      relay: ($relay | group({
        name: (.relay.name // .name | str),
        prices: [(.relay.prices // .relay.pricing // .prices // {}) | to_entries[]? | {name: (.key | str), price: (.value | str)}],
        blocklist: [(.relay.blocklist // .blocklist // [])[]? | str]
      })),
      peers: ($peers | group(items("peers") | [.[] | {
        id: (.id // .peer_id // .peer // .address // .name | str),
        direction: (.direction | str), status: (.status // .state | str)}])),
      channels: ($channels | group(items("channels") | [.[] | {
        peer: (.peer // .peer_id // .counterparty // .id | str),
        direction: (.direction | str), status: (.status // .state | str),
        collateral: (.collateral // .capacity // .deposit | str)}])),
      # toon 0.2.0 lists the routes of the node and the ones it forwards apart.
      routes: ($routes | group((items("routes") + (if type == "object" then (.forwarding_routes // []) else [] end)) | [.[] | {
        prefix: (.prefix // .destination // .route | str),
        peer: (.peer // .next_hop // .via // .peer_id // .handler_url | str), price: (.price // .rate | str)}])),
      limits: ($limits | group({
        per_command: (.per_command // .limits.per_command // .command | str),
        per_day: (.per_day // .limits.per_day // .daily // .day | str),
        remaining_today: (.remaining_today // .limits.remaining_today // .remaining | str)})),
      packets: ($packets | group(
        if (.packets.fulfilled | type) == "number" and (.packets.rejected | type) == "number"
          and (.rejects | type) == "object" and all(.rejects[]; type == "number")
          and (.fees_earned | type) == "string"
        then {fulfilled: .packets.fulfilled, rejected: .packets.rejected,
          rejects: [.rejects | to_entries | sort_by(.key)[] | {code: .key, count: .value}],
          fees_earned: .fees_earned}
        else error("shape") end)),
      rejected_packets: ($rejected | group(
        if (.packets | type) == "array"
        then [.packets[] | select(type == "object" and .outcome == "rejected"
            and all(.time, .destination, .code, .message; type == "string"))
          | {time, destination, code, message}]
        else error("shape") end)),
      packet_history: ($history | group(
        if (.packets | type) == "array"
        then {packets: [.packets[] | select(type == "object" and (.time | type) == "string"
            and (.outcome | type) == "string")
          | {time, direction, destination, from, to, amount, fee, outcome, code, message}
          | with_entries(select(.value | type == "string"))],
          dropped: (if (.dropped | type) == "number" then .dropped else 0 end)}
        else error("shape") end)),
      subscriptions: (if $held == null and $incoming == null then null else {
        held: ($held | group(items("subscriptions") | [.[] | str])),
        incoming: ($incoming | group(items("subscriptions") | length))} end),
      # A line the connector wrote as JSON is read for its time, level and message.
      logs: ($logs | group(items("lines") | [.[-20:][] | (if type == "object" then (.message // .line // .) else . end) | str
        | ((try fromjson catch null) as $j | if ($j | type) == "object" and (($j.fields.message // $j.message) | type) == "string"
           then [($j.timestamp | strings | .[11:19]), ($j.level | strings | ascii_downcase), ($j.fields.message // $j.message)] | map(select(. != null and . != "")) | join("  ")
           else . end)]))
    }' 2>/dev/null) || state=null
fi

# Compare the state with the last snapshot: one entry per difference, kept with
# the earlier ones. Groups that could not be read are not compared, and keep
# what the snapshot held of them. Without a state nothing is read or written.
if [[ $state != null ]]; then
  old=$(jq -c 'if type == "object" then . else null end' "$snapshot" 2>/dev/null)
  result=$(jq -cn --argjson old "${old:-null}" --argjson state "$state" --argjson now "$now" --argjson gap "$((interval * 4))" \
    --argjson install "${install_doc:-null}" --arg source "$($install && echo install || echo host)" '
    def keyed(f): map({(f): .}) | add // {};
    def entry($group; $name; $text): {group: $group, name: $name, text: $text};
    # Entries for what was added, removed and changed between two lists.
    def delta($o; $n; kf; added; removed; changed):
      if $o == null or $n == null then []
      else ($o | keyed(kf)) as $a | ($n | keyed(kf)) as $b
        | [$b | to_entries[] | select($a[.key] == null) | .value | added]
        + [$a | to_entries[] | select($b[.key] == null) | .value | removed]
        + [$b | to_entries[] | select($a[.key] != null and $a[.key] != .value) | .value | changed] end;
    def blank: if . == "" then null else . end;
    ($state.limits.remaining_today | blank) as $left
    # The apps and the ones waiting for the Observer, from the Install when there is one.
    | ($state.status.apps | if . == null then null else map({name, running}) end) as $apps
    | ($install | if type == "object" then [.waiting_apps[] | {name, image}] else null end) as $waiting
    | {peers: $state.peers, channels: $state.channels, routes: $state.routes,
       prices: $state.relay.prices, remaining: $left, apps: $apps, waiting: $waiting} as $cur
    | ($old // {}) as $o
    | ([$cur | to_entries[] | {(.key): (.value // $o[.key])}] | add + {source: $source}) as $new
    # A snapshot of another node (an Install made since, say) is not compared.
    | (if $old != null and ($o.source // "host") == $source then
        delta($o.peers; $new.peers; (.id + "|" + .direction);
          entry("Peerings"; .id; "Peering with \(.id) added");
          entry("Peerings"; .id; "Peering with \(.id) removed");
          entry("Peerings"; .id; "Peering with \(.id) is now \(.status)"))
        + delta($o.channels; $new.channels; (.peer + "|" + .direction);
          entry("Channels"; .peer; "Channel with \(.peer) opened");
          entry("Channels"; .peer; "Channel with \(.peer) closed");
          entry("Channels"; .peer; "Channel with \(.peer) is now \(.status)"))
        + delta($o.routes; $new.routes; .prefix;
          entry("Routes"; .prefix; "Route \(.prefix) added");
          entry("Routes"; .prefix; "Route \(.prefix) removed");
          entry("Routes"; .prefix; "Route \(.prefix) changed"))
        + delta($o.prices; $new.prices; .name;
          entry("Relay"; "Price " + .name; "Price \(.name) set to \(.price)");
          entry("Relay"; "Price " + .name; "Price \(.name) removed");
          entry("Relay"; "Price " + .name; "Price \(.name) changed to \(.price)"))
        + delta($o.apps; $new.apps; .name;
          entry("Apps"; .name; "App \(.name) added");
          entry("Apps"; .name; "App \(.name) removed");
          entry("Apps"; .name; "App \(.name) is now \(if .running then "running" else "stopped" end)"))
        + delta($o.waiting; $new.waiting; .name;
          entry("Waiting for your approval"; .name; "App \(.name) waits for your approval");
          entry("Waiting for your approval"; .name; "App \(.name) no longer waits for approval");
          entry("Waiting for your approval"; .name; "App \(.name) asks for another image"))
        + (if $o.remaining != null and $new.remaining != null and $o.remaining != $new.remaining
            then [entry("Spending limit"; "Left today";
              (if ($new.remaining | tonumber? // 1) <= 0 then "Spending limit used up for today"
               else "Spending limit: \($new.remaining) left today, was \($o.remaining)" end))]
            else [] end)
      else [] end) as $found
    | (if ($found | length) == 0 then []
       elif ($now - ($o.at // 0)) > $gap then
         [{group: null, name: null, text: ("Since you last looked: " + ($found | map(.text) | join("; ")))}]
       else $found end) as $fresh
    | ($fresh | to_entries | map(.value + {id: "node-\($now)-\(.key)", kind: "node-change", node_change: true,
        noticed_at: $now, created_at: $now,
        target: (if .value.group then {group: .value.group, label: .value.name} else null end)}
        | del(.group, .name))) as $entries
    | (($entries + ($o.changes // [])) | .[:50]) as $kept
    | {changes: $kept, snapshot: ($new + {at: $now, changes: $kept})}
  ' 2>/dev/null)
  if [[ -n $result ]]; then
    changes=$(jq -c '.changes' <<<"$result")
    if mkdir -p "$state_dir" 2>/dev/null; then
      jq -c '.snapshot' <<<"$result" > "$snapshot.$$" 2>/dev/null && mv -f "$snapshot.$$" "$snapshot" 2>/dev/null || rm -f "$snapshot.$$"
    fi
  fi
  urgent=$(jq -c '.limits.remaining_today | strings | (tonumber? // null) | . != null and . <= 0' <<<"$state" 2>/dev/null)
  [[ $urgent == true ]] || urgent=false
fi

read_address=$(jq -r '.agent_node.toon_apps[]?.apps[]? | select(.name == "relay" and .running) | .read_address // empty' <<<"$status" 2>/dev/null |
  head -n1)
[[ -n $read_address ]] || offline

# Every event, whatever its kind, each with the parts a Renderer resolves for
# it; then the profiles that name their authors and the follow lists that count
# their followers.
# The descriptions go in as a file, not an argument, so that however many there
# are they cannot exceed the length of one argument and empty the feed.
with_parts() { jq -c --slurpfile custom <(printf '%s' "$custom_renderers") "$renderers"' map(. + {parts: parts})' 2>/dev/null || echo '[]'; }
events=$(relay_query "{\"limit\":$limit}" | with_parts)
profiles=$(relay_query '{"kinds":[0],"limit":200}')
follows=$(relay_query '{"kinds":[3],"limit":500}')
name=$(jq -r '.relay.name // ""' <<<"$relay_config" 2>/dev/null)

# What the agent itself signed, asked for by author so a busy network cannot
# push it out of the feed's limit.
agent_events='[]'
[[ -n $self ]] && agent_events=$(relay_query "{\"authors\":[\"$self\"],\"limit\":$limit}" | with_parts)

# The events a thread needs beyond the limit: what shown events refer to, up
# the chain a few levels, and what refers to them. Asked for by id and by "e"
# tag; an event asked for by id that the relay does not return is missing.
# One higher up than the walk reaches is neither held nor missing.
ref_of='[.tags[]? | select(type == "array" and .[0] == "e" and (.[1] | strings))]
  | ((map(select(.[3]? == "reply")) | first) // last) | .[1]? // null'
context='[]'
asked='[]'
for _ in 1 2 3; do
  want=$(jq -cn --argjson a "$events" --argjson b "${agent_events:-[]}" --argjson c "$context" --argjson asked "$asked" \
    "[\$a[], \$b[], \$c[]] | (map(.id) | unique) as \$held
     | [.[] | $ref_of | select(. != null)] | unique - \$held - \$asked | .[0:100]" 2>/dev/null || echo '[]')
  [[ $want == '[]' ]] && break
  asked=$(jq -cn --argjson a "$asked" --argjson b "$want" '$a + $b' 2>/dev/null || echo "$asked")
  found=$(relay_query "{\"ids\":$want}")
  context=$(jq -cn --argjson a "$context" --argjson b "$found" '$a + $b | unique_by(.id)' 2>/dev/null || echo "$context")
  [[ $found == '[]' ]] && break
done
ids=$(jq -cn --argjson a "$events" --argjson b "${agent_events:-[]}" --argjson c "$context" '[$a[], $b[], $c[] | .id | strings] | unique | .[0:100]' 2>/dev/null || echo '[]')
replies=$(relay_query "{\"#e\":$ids,\"limit\":200}")
context=$(jq -cn --argjson a "$context" --argjson b "$replies" '$a + $b | unique_by(.id)' 2>/dev/null || echo "$context")
# The agent's own follow list, by author too: it says whom the agent follows.
own_follows='[]'
[[ -n $self ]] && own_follows=$(relay_query "{\"kinds\":[3],\"authors\":[\"$self\"],\"limit\":1}")

context=$(printf '%s' "$context" | with_parts)

# Events tagging the agent identity, asked for by tag for the same reason.
mention_events='[]'
[[ -n $self ]] && mention_events=$(relay_query "{\"#p\":[\"$self\"],\"limit\":$limit}")

# The node's ILP address and connector address, from the relay's NIP-11 document.
node=$(node_sh "curl -fsS --max-time 5 -H 'Accept: application/nostr+json' $(sh_quote "http://$read_address")" 2>/dev/null |
  jq -c '{ilp_address: (.ilp_address // .toon.ilp_address | strings // ""), connector: (.connector // .toon.connector_url | strings // "")}' 2>/dev/null)

# Who holds a subscription to this relay's live feed; null while it is not sold.
subscribers=$(jq -c 'if . == null then null else ([.. | arrays] | first // [] | length) end' <<<"$incoming" 2>/dev/null)

jq -cn --arg name "${name:-}" --arg self "$self" \
  --argjson node "${node:-null}" \
  --argjson subscribers "${subscribers:-null}" --argjson state "$state" --argjson events "${events:-[]}" \
  --argjson profiles "${profiles:-[]}" --argjson follows "${follows:-[]}" \
  --argjson own_follows "${own_follows:-[]}" \
  --argjson agent "${agent_events:-[]}" --argjson context "${context:-[]}" \
  --argjson asked "${asked:-[]}" --argjson looked "${looked_at:-null}" \
  --argjson mentioned "${mention_events:-[]}" \
  --argjson requests "${requests:-[]}" --argjson messages "${messages:-$no_messages}" \
  --argjson answered "$(request_activity "$self" "${requests:-[]}")" \
  --argjson changes "$changes" --argjson urgent "$urgent" \
  --argjson install "${install_doc:-null}" \
  '# The "e" tag marked "reply" (NIP-10), else the last one.
  def ref: '"$ref_of"';
  ([$agent[], $events[], $context[]] | unique_by(.id)) as $all
  | ($all | map(.id)) as $held
  | ($all | map(select(ref != null)) | sort_by(.created_at)
      | reduce .[] as $e ({}; .[$e | ref] += [$e.id])) as $referrers
  | def mark: map((ref) as $r | . + {refers_to: $r,
      refers_missing: ($r != null and ($held | index($r) == null) and ($asked | index($r) != null)),
      referenced_by: ($referrers[.id] // [])});
  (if $self == "" then []
    else ([$agent[], $events[]] | map(select(.pubkey == $self)) | unique_by(.id)
      | sort_by(-.created_at) | mark)
    end) as $signed
  # Answers count whether or not the public key is known.
  | ($signed + $answered | sort_by(-.created_at)) as $activity
  | ([$mentioned[], $events[] | select(.pubkey != $self and $self != ""
      and any(.tags[]?; .[0] == "p" and .[1] == $self))]) as $mentions
  # The Persona: the newest profile of the agent identity that has a name.
  | ([$profiles[] | select($self != "" and .pubkey == $self)
      | (.content | try fromjson catch null) as $m
      | select(($m | type) == "object")
      | ($m.name | strings | gsub("^\\s+|\\s+$"; "")) as $name
      | select($name != "")
      | {name: $name, character: ($m.about | strings // ""),
         picture: ($m.picture | strings // ""), created_at: .created_at}]
    | sort_by(.created_at) | last // null) as $persona
  | {online: true, name: $name, self: $self, persona: $persona,
    activity: (($activity + $changes) | sort_by(-.created_at)), last_active: ($activity[0].created_at? // null),
    urgent: $urgent,
    node: ($node // {ilp_address: "", connector: ""}),
    requests: $requests, messages: $messages, subscribers: $subscribers, state: $state, install: $install, profiles: $profiles, follows: ([$own_follows[], $follows[]] | unique_by(.id)),
    events: ($events | map(select(.pubkey != $self)) | mark),
    context: ($context | map(select(.id as $i | ($events | map(.id) | index($i)) == null and ($agent | map(.id) | index($i)) == null)) | mark),
    looked_at: $looked,
    # A spent spending limit is urgent. Without a record of
    # looking there is nothing to compare with.
    attention: (if $urgent then "urgent"
      elif $looked == null then "none"
      elif any(($activity + $changes + $mentions)[]; .created_at > $looked) then "news"
      # A private message to the agent is news too; one it sent is not.
      elif any($messages.conversations[].messages[]; .sent == false and .created_at > $looked) then "news"
      else "none" end)}'
